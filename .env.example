# ─────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
POSTGRES_USER=aimarketing
POSTGRES_PASSWORD=aimarketing
POSTGRES_DB=aimarketing
DATABASE_URL=postgresql+asyncpg://aimarketing:aimarketing@localhost:5432/aimarketing

# ─────────────────────────────────────────────
# Redis / Celery
# ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─────────────────────────────────────────────
# Storage (MinIO / S3-compatible)
# ─────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=aimarketing-media
MINIO_USE_SSL=false

# ─────────────────────────────────────────────
# AI — Anthropic Claude
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─────────────────────────────────────────────
# Image Generation — Canva Connect API
# ─────────────────────────────────────────────
# 1. Go to https://www.canva.com/developers/
# 2. Create an App → enable "client_credentials" OAuth grant
# 3. Copy Client ID and Client Secret below
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=

# ─────────────────────────────────────────────
# Video Generation — Higgsfield AI
# ─────────────────────────────────────────────
# 1. Sign up at https://cloud.higgsfield.ai
# 2. Go to API Keys section → create new key + secret
# 3. Free tier: 150 credits/month ($1 = 16 credits)
HF_API_KEY=
HF_SECRET=

# ─────────────────────────────────────────────
# Meta (Facebook + Instagram)
# ─────────────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─────────────────────────────────────────────
# TikTok (research only via Apify)
# ─────────────────────────────────────────────
APIFY_API_TOKEN=

# ─────────────────────────────────────────────
# Xiaohongshu (cookie-based, rotate regularly)
# ─────────────────────────────────────────────
XHS_COOKIE_1=
XHS_COOKIE_2=
XHS_COOKIE_3=
# Chinese residential proxy: e.g. socks5://user:pass@cn-proxy.example.com:60000
XHS_PROXY_URL=

# ─────────────────────────────────────────────
# Google Sheets Export
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/export/google-sheets/callback
